{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sweeper",
  "version": "0.1.0",
  "identifier": "com.sweeper.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "freezePrototype": true,
      "capabilities": ["default"],
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "isolation"
        }
      }
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Sweeper Contributors",
    "shortDescription": "Safety-first Windows desktop disk cleaner.",
    "longDescription": "Sweeper discovers reclaimable space on Windows, explains each target, and removes only confirmed items using safety-first validation and handle-based deletion.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
